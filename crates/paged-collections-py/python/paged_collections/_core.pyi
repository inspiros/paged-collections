from collections.abc import Iterable, Iterator, Mapping
from typing import Any, ClassVar, Generic, TypeVar, overload

import numpy as np
import numpy.typing as npt

__version__: str
KEY_LIMIT: int

_T = TypeVar("_T")
_S = TypeVar("_S", bound=np.generic)
_D = TypeVar("_D")

# Keys: integers in 0 <= key < 2**32, as scalars or batches.
_KeyBatch = npt.ArrayLike
_U32Array = npt.NDArray[np.uint32]
_BoolArray = npt.NDArray[np.bool_]

class SparseSet:
    def __init__(self, keys: _KeyBatch | None = None) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def __iter__(self) -> Iterator[int]: ...
    def __eq__(self, other: object) -> bool: ...
    def copy(self) -> SparseSet: ...
    def add(self, key: int) -> None: ...
    def discard(self, key: int) -> None: ...
    def remove(self, key: int) -> None: ...
    def pop(self) -> int: ...
    def clear(self) -> None: ...
    def add_many(self, keys: _KeyBatch) -> int: ...
    def discard_many(self, keys: _KeyBatch) -> int: ...
    def contains_many(self, keys: _KeyBatch) -> _BoolArray: ...
    def to_array(self) -> _U32Array: ...
    def view(self) -> _U32Array: ...
    def sort(self) -> None: ...
    def reserve(self, additional: int) -> None: ...
    def shrink_to_fit(self) -> None: ...
    @property
    def allocated_pages(self) -> int: ...

class _MapBase(Generic[_T]):
    # Shared API of SparseMap and the typed maps. Not a runtime class.
    dtype: ClassVar[str]
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def __getitem__(self, key: int) -> _T: ...
    def __setitem__(self, key: int, value: _T) -> None: ...
    def __delitem__(self, key: int) -> None: ...
    def __iter__(self) -> Iterator[int]: ...
    def __eq__(self, other: object) -> bool: ...
    @overload
    def get(self, key: int) -> _T | None: ...
    @overload
    def get(self, key: int, default: _D) -> _T | _D: ...
    @overload
    def pop(self, key: int) -> _T: ...
    @overload
    def pop(self, key: int, default: _D) -> _T | _D: ...
    def popitem(self) -> tuple[int, _T]: ...
    def update(self, other: Mapping[int, _T] | Iterable[tuple[int, _T]]) -> None: ...
    def clear(self) -> None: ...
    def keys(self) -> _U32Array: ...
    def items(self) -> list[tuple[int, _T]]: ...
    def keys_view(self) -> _U32Array: ...
    def set_many(self, keys: _KeyBatch, values: Any) -> int: ...
    def contains_many(self, keys: _KeyBatch) -> _BoolArray: ...
    def discard_many(self, keys: _KeyBatch) -> int: ...
    def sort_keys(self) -> None: ...
    def reserve(self, additional: int) -> None: ...
    def shrink_to_fit(self) -> None: ...
    @property
    def allocated_pages(self) -> int: ...

class SparseMap(_MapBase[Any]):
    def __init__(self, keys: _KeyBatch | None = None, values: Iterable[Any] | None = None) -> None: ...
    def copy(self) -> SparseMap: ...
    def setdefault(self, key: int, default: Any = None) -> Any: ...
    def values(self) -> list[Any]: ...
    def get_many(self, keys: _KeyBatch, *default: Any) -> list[Any]: ...

class _TypedMap(_MapBase[_T], Generic[_T, _S]):
    # Shared API of the typed maps. Not a runtime class.
    def __init__(self, keys: _KeyBatch | None = None, values: npt.ArrayLike | None = None) -> None: ...
    def copy(self) -> Any: ...
    def setdefault(self, key: int, default: _T) -> _T: ...
    def values(self) -> npt.NDArray[_S]: ...
    def values_view(self) -> npt.NDArray[_S]: ...
    def get_many(self, keys: _KeyBatch, default: _T | None = None) -> npt.NDArray[_S]: ...

class SparseMapF64(_TypedMap[float, np.float64]): ...
class SparseMapF32(_TypedMap[float, np.float32]): ...
class SparseMapI64(_TypedMap[int, np.int64]): ...
class SparseMapI32(_TypedMap[int, np.int32]): ...
class SparseMapU64(_TypedMap[int, np.uint64]): ...
class SparseMapU32(_TypedMap[int, np.uint32]): ...
class SparseMapBool(_TypedMap[bool, np.bool_]): ...

class _DirectMapBase(Generic[_T]):
    # Shared API of DirectMap and the typed direct maps. Not a runtime class.
    dtype: ClassVar[str]
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def __getitem__(self, key: int) -> _T: ...
    def __setitem__(self, key: int, value: _T) -> None: ...
    def __delitem__(self, key: int) -> None: ...
    def __iter__(self) -> Iterator[int]: ...
    def __eq__(self, other: object) -> bool: ...
    @overload
    def get(self, key: int) -> _T | None: ...
    @overload
    def get(self, key: int, default: _D) -> _T | _D: ...
    @overload
    def pop(self, key: int) -> _T: ...
    @overload
    def pop(self, key: int, default: _D) -> _T | _D: ...
    def popitem(self) -> tuple[int, _T]: ...
    def update(self, other: Mapping[int, _T] | Iterable[tuple[int, _T]]) -> None: ...
    def clear(self) -> None: ...
    def keys(self) -> _U32Array: ...
    def items(self) -> list[tuple[int, _T]]: ...
    def set_many(self, keys: _KeyBatch, values: Any) -> int: ...
    def contains_many(self, keys: _KeyBatch) -> _BoolArray: ...
    def discard_many(self, keys: _KeyBatch) -> int: ...
    def shrink_to_fit(self) -> None: ...
    @property
    def allocated_pages(self) -> int: ...
    def first_item(self) -> tuple[int, _T]: ...
    def last_item(self) -> tuple[int, _T]: ...
    def pop_first(self) -> tuple[int, _T]: ...
    def pop_last(self) -> tuple[int, _T]: ...
    def next_occupant(self, index: int) -> tuple[int, _T] | None: ...
    def prev_occupant(self, index: int) -> tuple[int, _T] | None: ...
    def items_range(self, start: int | None = None, stop: int | None = None) -> list[tuple[int, _T]]: ...
    def keys_range(self, start: int | None = None, stop: int | None = None) -> _U32Array: ...

class DirectMap(_DirectMapBase[Any]):
    def __init__(self, keys: _KeyBatch | None = None, values: Iterable[Any] | None = None) -> None: ...
    def copy(self) -> DirectMap: ...
    def setdefault(self, key: int, default: Any = None) -> Any: ...
    def values(self) -> list[Any]: ...
    def values_range(self, start: int | None = None, stop: int | None = None) -> list[Any]: ...
    def get_many(self, keys: _KeyBatch, *default: Any) -> list[Any]: ...

class _TypedDirectMap(_DirectMapBase[_T], Generic[_T, _S]):
    # Shared API of the typed direct maps. Not a runtime class.
    def __init__(self, keys: _KeyBatch | None = None, values: npt.ArrayLike | None = None) -> None: ...
    def copy(self) -> Any: ...
    def setdefault(self, key: int, default: _T) -> _T: ...
    def values(self) -> npt.NDArray[_S]: ...
    def values_range(self, start: int | None = None, stop: int | None = None) -> npt.NDArray[_S]: ...
    def get_many(self, keys: _KeyBatch, default: _T | None = None) -> npt.NDArray[_S]: ...

class DirectMapF64(_TypedDirectMap[float, np.float64]): ...
class DirectMapF32(_TypedDirectMap[float, np.float32]): ...
class DirectMapI64(_TypedDirectMap[int, np.int64]): ...
class DirectMapI32(_TypedDirectMap[int, np.int32]): ...
class DirectMapU64(_TypedDirectMap[int, np.uint64]): ...
class DirectMapU32(_TypedDirectMap[int, np.uint32]): ...
class DirectMapBool(_TypedDirectMap[bool, np.bool_]): ...

class _DirectMapIterator(Iterator[int]):
    # Shared API of the direct-map iterators. Not a runtime class.
    def __iter__(self) -> Iterator[int]: ...
    def __next__(self) -> int: ...
    def __length_hint__(self) -> int: ...

class DirectMapIterator(_DirectMapIterator): ...
class DirectMapBoolIterator(_DirectMapIterator): ...
class DirectMapF32Iterator(_DirectMapIterator): ...
class DirectMapF64Iterator(_DirectMapIterator): ...
class DirectMapI32Iterator(_DirectMapIterator): ...
class DirectMapI64Iterator(_DirectMapIterator): ...
class DirectMapU32Iterator(_DirectMapIterator): ...
class DirectMapU64Iterator(_DirectMapIterator): ...
